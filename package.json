{
  "name": "online-shop",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "maildev": "ts-node -r tsconfig-paths/register ./src/mail/maildev/index.ts",
    "start:dev": "nest start --watch",
    "dev": "npm-run-all --parallel --continue-on-error maildev start:dev",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "pretypeorm": "ts-node -r tsconfig-paths/register ./src/database/scripts/copy-typeorm-config.ts",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "seeds": "ts-node -r tsconfig-paths/register ./node_modules/typeorm-seeding/dist/cli.js",
    "migration:generate": "npm run typeorm -- migration:generate -n",
    "migration:create": "npm run typeorm -- migration:create -n",
    "migration:run": "npm run typeorm -- migration:run",
    "seed:config": "npm run seeds -- config",
    "seed": "npm run seeds -- seed",
    "seed:run": "npm-run-all --sequential pretypeorm seed",
    "seed:c1-canonical": "ts-node -r tsconfig-paths/register src/database/seeds/phase-c1-local-canonical-taxonomy.seed.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:integration": "jest --config ./test/jest-integration.json",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs-modules/mailer": "^1.6.1",
    "@nestjs/common": "^8.0.0",
    "@nestjs/core": "^8.0.0",
    "@nestjs/jwt": "^8.0.0",
    "@nestjs/passport": "^8.2.1",
    "@nestjs/platform-express": "^8.0.0",
    "@nestjs/schedule": "^2.1.0",
    "@nestjs/swagger": "^5.2.1",
    "@nestjs/typeorm": "8.0.3",
    "@ragashop/marketplace-identity-lease": "file:packages/marketplace-identity-lease",
    "axios": "^1.3.2",
    "bcryptjs": "^2.4.3",
    "cache-manager": "4",
    "cache-manager-redis-yet": "^5.1.5",
    "cheerio": "1.0.0-rc.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.13.2",
    "crypto-js": "^4.1.1",
    "dotenv": "^16.0.0",
    "handlebars": "^4.7.7",
    "helmet": "^7.2.0",
    "ico-endec": "^0.1.6",
    "install": "^0.13.0",
    "ioredis": "^5.8.2",
    "jalali-moment": "^3.3.11",
    "mysql2": "^2.3.3",
    "nestjs-i18n": "^10.2.6",
    "nestjs-telegraf": "^2.7.0",
    "nodemailer": "^6.7.4",
    "passport": "^0.5.2",
    "passport-jwt": "^4.0.0",
    "reflect-metadata": "^0.1.13",
    "request-ip": "^2.1.3",
    "rimraf": "^3.0.2",
    "rxjs": "^7.2.0",
    "sharp": "^0.31.0",
    "soap": "^1.0.2",
    "socks-proxy-agent": "^9.0.0",
    "swagger-ui-express": "^4.3.0",
    "telegraf": "^4.16.3",
    "typeorm": "0.2",
    "typeorm-seeding": "^1.6.1",
    "uuid": "^8.3.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^8.0.0",
    "@nestjs/schematics": "^8.0.0",
    "@nestjs/testing": "^8.0.0",
    "@types/crypto-js": "^4.1.1",
    "@types/express": "^4.17.13",
    "@types/jest": "27.0.2",
    "@types/multer": "^1.4.7",
    "@types/node": "^16.0.0",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "^27.2.5",
    "maildev": "^2.0.5",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.3.2",
    "source-map-support": "^0.5.20",
    "supertest": "^6.1.3",
    "ts-jest": "^27.0.3",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "^3.10.1",
    "typescript": "^4.3.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@ragashop/marketplace-identity-lease$": "<rootDir>/../packages/marketplace-identity-lease/index.js"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
