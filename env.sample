NODE_ENV=development
APP_PORT=9009
APP_NAME="Online Shop Project"
APP_TYPE=share
API_BASE_URL=http://localhost:9009
PANEL_BASE_URL=http://localhost:3009
SITE_BASE_URL=http://localhost:9000
BASE_DOMAIN=artitek.ir

DATABASE_NAME=online_shop
DATABASE_USERNAME=root
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_TYPE=mysql

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_IGNORE_TLS=true
MAIL_SECURE=false
MAIL_REQUIRE_TLS=false
MAIL_DEFAULT_EMAIL=info@onlineshop.ir
MAIL_SALES_EMAIL=sales@onlineshop.ir
MAIL_DEFAULT_NAME=Support
MAIL_CLIENT_PORT=1080

AUTH_JWT_SECRET=secret
AUTH_JWT_TOKEN_EXPIRES_IN=1h
AUTH_JWT_TOKEN_LIFETIME_EXPIRES_IN=30d
CUSTOMER_JWT_SECRET=secret2

# Optional dedicated HMAC secret for unpublished /static/home draft tokens (`hda`).
# Falls back to AUTH_JWT_SECRET when unset. Never commit real values.
# HOME_DRAFT_ASSET_SECRET=

# live or sandbox
GATEWAY_MODE=live

AMOOTSMS_USERNAME=
AMOOTSMS_PASSWORD=
KAVENEGAR_SECRET_KEY=

VATANSMS_API_ID=
VATANSMS_API_KEY=

SWAGGER_DEFAULT_LANGUAGE=
SWAGGER_DEFAULT_TOKEN=

MAX_PHOTO_FILE_SIZE=1048576
MAX_VIDEO_FILE_SIZE=5242880
MAX_PRODUCT_FILE_SIZE=10485760
PRODUCT_FILE_TYPES=pdf,txt,psd,doc,docx,xls,xlsx,zip,rar,iso,ai,esp,ppt,pptx,wav,aif,mp3,aac,jpg,jpeg,gif,bmp,png,svg,m4v,avi,mpg,mp4,webm

SMS_COUNT_ALERT=20

PASSWORD_CRYPTO_FILE=

AI_DEEPSEEK_TOKEN=

TELEGRAM_BOT_TOKEN=

# * * * * * *
# | | | | | |
# | | | | | day of week
# | | | | months
# | | | day of month
# | | hours
# | minutes
# seconds (optional)
# Phase C1 unpaid inventory cleanup (opt-in). Cron may fire; work gated by ENABLED.
UNPAID_ORDER_CLEANUP_ENABLED=false
UNPAID_ORDER_TIMEOUT_HOURS=24
UNPAID_ORDER_CLEANUP_BATCH_SIZE=100
CRON_JOB_DELETE_UNPAID_ORDER = "0 0 * * * *" # every hour
# F1 TGJU TRY rate refresh (~5 minutes). Set FX_RATE_REFRESH_ENABLED=false to disable.
CRON_JOB_TRY_TO_RIAL = "*/5 * * * *"
FX_RATE_REFRESH_ENABLED=false
# Max age of last successful TGJU fetch for NEW order creation (ms). Default 15 minutes.
FX_RATE_MAX_AGE_MS=900000
# One-time empty-table settings bootstrap via POST /settings/bootstrap. Default off.
# Set true only for authorized empty Production init, then set false again after success.
SETTINGS_BOOTSTRAP_ENABLED=false
CRON_JOB_CRAWLER_PRODUCT_DETAILS = "0 0 * * * *" # every hour
CRON_JOB_CRAWLER_PRODUCT_PAGES = "0 */6 * * * *" # every 6 min

CRAWLER_BASE_URL=http://127.0.0.1:9020
CRAWLER_INTERNAL_SECRET=
CRAWLER_REQUEST_TIMEOUT_MS=120000
MARKETPLACE_IMPORT_RATE_LIMIT_WINDOW_MS=60000
MARKETPLACE_IMPORT_RATE_LIMIT_MAX=10
MARKETPLACE_IMPORT_RATE_LIMIT_MAX_KEYS=10000
MARKETPLACE_IMPORT_MAX_CONCURRENT=3
MARKETPLACE_IMPORT_MAX_QUEUE=20
MARKETPLACE_IMPORT_QUEUE_TIMEOUT_MS=30000
MARKETPLACE_REDIRECT_MAX_HOPS=10
MARKETPLACE_REDIRECT_TIMEOUT_MS=10000
MARKETPLACE_REDIRECT_TOTAL_TIMEOUT_MS=15000
API_JSON_BODY_LIMIT=2mb
MARKETPLACE_IMPORT_BODY_LIMIT=8kb
MARKETPLACE_JOB_MAX_ATTEMPTS=3
MARKETPLACE_JOB_LEASE_MS=300000
MARKETPLACE_JOB_RETRY_BASE_MS=5000
MARKETPLACE_JOB_RETRY_MAX_MS=120000
MARKETPLACE_JOB_POLL_INTERVAL_MS=2000
MARKETPLACE_JOB_WORKER_ENABLED=true
MARKETPLACE_IDENTITY_LEASE_MS=600000
# Optional; must be >= effective crawler identity lease (API fetches crawler
# /internal/marketplace-identity-config at startup when CRAWLER_BASE_URL is set):
# MARKETPLACE_IMPORT_IN_PROGRESS_SOFT_WINDOW_MS=600000
# MARKETPLACE_SKIP_CRAWLER_LEASE_CHECK=true
TRUST_PROXY=false
TRUST_PROXY_MODE=off
TRUST_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# Launch security (CORS / Swagger / auth rate limits)
# ---------------------------------------------------------------------------
# Comma-separated exact browser origins (scheme + host + optional port).
# Required in production. Local defaults (when unset, non-production only):
# SITE_BASE_URL, PANEL_BASE_URL, admin :4445, storefront-next :4450
CORS_ORIGINS=http://127.0.0.1:4445,http://localhost:4445,http://127.0.0.1:4450,http://localhost:4450

# Swagger UI at /docs. Default: enabled outside production, disabled in production.
# SWAGGER_ENABLED=false

# Auth / OTP hard rate limits (in-memory per API process; see README security notes)
# AUTH_RATE_LIMIT_LOGIN_WINDOW_MS=60000
# AUTH_RATE_LIMIT_LOGIN_MAX_PER_IP=20
# AUTH_RATE_LIMIT_LOGIN_MAX_PER_IDENTITY=10
# AUTH_RATE_LIMIT_OTP_SEND_WINDOW_MS=60000
# AUTH_RATE_LIMIT_OTP_SEND_MAX_PER_IP=10
# AUTH_RATE_LIMIT_OTP_SEND_MAX_PER_IDENTITY=3
# AUTH_RATE_LIMIT_OTP_VERIFY_WINDOW_MS=60000
# AUTH_RATE_LIMIT_OTP_VERIFY_MAX_PER_IP=30
# AUTH_RATE_LIMIT_OTP_VERIFY_MAX_PER_IDENTITY=10
# AUTH_RATE_LIMIT_MAX_KEYS=20000

# Behind one reverse proxy (nginx/apache): TRUST_PROXY_MODE=hops TRUST_PROXY_HOPS=1
# Do not set TRUST_PROXY=true blindly; spoofed X-Forwarded-For must not choose rate-limit identity.